#Область ПрограммныйИнтерфейс

// Проверяет персональные исключения и вызывает штатную блокировку внешних ресурсов при запуске клиента.
//
Процедура ПодготовитьЗапускАрхивнойБазы() Экспорт
	
	ПолнаяБлокировкаСервер.ПроверитьПерсональныеИсключения(
		ПолнаяБлокировкаСерверПереопределяемый.ИдентификаторыПривилегированныхПользователей());
	ПроверитьУстановитьБлокировкуРаботыСВнешнимиРесурсами();
	
КонецПроцедуры

// Включает штатную блокировку внешних ресурсов БСП, если механизм доступен и блокировка выключена.
// При ошибке сохраняет подробности в журнале регистрации и продолжает запуск клиента.
//
Процедура ПроверитьУстановитьБлокировкуРаботыСВнешнимиРесурсами() Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("БлокировкаРаботыСВнешнимиРесурсами") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		// Фиксированное имя модуля сохраняет применимость расширения без БСП.
		АдаптерБСП = Вычислить("БлокировкаРаботыСВнешнимиРесурсами");
		Если Не АдаптерБСП.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
			АдаптерБСП.ЗапретитьРаботуСВнешнимиРесурсами();
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("БлокировкаАрхива.ВнешниеРесурсы", УровеньЖурналаРегистрации.Ошибка,
			, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

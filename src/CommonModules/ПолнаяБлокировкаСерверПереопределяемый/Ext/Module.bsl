#Область СлужебныйПрограммныйИнтерфейс

// Возвращает массив УИДов пользователей, для кого будет игнорироваться любой запрет.
// для настройки расширения необходимо добавить их в данный метод
//
// пример добавления исключения
//Идентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
//ИдентификаторыПривилегированныхПользователей.Добавить(Идентификатор);
//
// Возвращаемое значение:
//   Массив   - УИДы справочника пользователи
//
Функция ИдентификаторыПривилегированныхПользователей() Экспорт
	
	ИдентификаторыПривилегированныхПользователей = Новый Массив;
	
	Возврат ИдентификаторыПривилегированныхПользователей;
	
КонецФункции

// Возвращает типы объектов для игнорирования запрета на запись. Все типы добавляются только через
// метод ДобавитьВИсключения, для контроля существования типа
//
// Доступные типы для добавления:
//            ПланВидовРасчетаОбъект,
//            ПланСчетовОбъект,
//            ПланВидовХарактеристикОбъект,
//            ПланОбменаОбъект,
//            СправочникОбъект
//
// пример добавления исключения
//ДобавитьВИсключения(Исключения, "СправочникОбъект.ИмяСправочника");
//
// Возвращаемое значение:
//   Массив   - Массив типов объектов исключений
//
Функция ИсключенияДляСправочнойИнформации() Экспорт
	
	Исключения = Новый Массив;
	
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ВариантыОтчетов");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ВерсииРасширений");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ИдентификаторыОбъектовРасширений");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ПредопределенныеВариантыОтчетов");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.РабочиеМеста");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.УведомленияПрограммы");
	
	Возврат Исключения;
	
КонецФункции

// Возвращает типы объектов для игнорирования запрета на запись. Все типы добавляются только через
// метод ДобавитьВИсключения, для контроля существования типа
//
// Доступные типы для добавления:
//            РегистрСведенийНаборЗаписей,
//            РегистрБухгалтерииНаборЗаписей,
//            РегистрНакопленияНаборЗаписей,
//            РегистрРасчетаНаборЗаписей
//
// пример добавления исключения
//ДобавитьВИсключения(Исключения, "РегистрСведенийНаборЗаписей.ИмяРегистра");
//
// Возвращаемое значение:
//   Массив   - Массив типов объектов исключений
//
Функция ИсключенияДляРегистров() Экспорт
	
	Исключения = Новый Массив;
	
	ДобавитьВИсключения(Исключения, "РегистрСведенийНаборЗаписей.СведенияОПользователях");
	
	ДобавитьРегистрыПодсистемыПервогоУровня(Исключения, "Сведений", "УправлениеБизнесПроцессами");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "ИнтернетПоддержкаПользователей", "Новости");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "ИнтернетПоддержкаПользователей", "РасписанияРегламентныхЗаданий");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "НастройкаИАдминистрирование", "Метрики");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СлужебныеПодсистемы", "МобильныйКлиент");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемы", "БазоваяФункциональность");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемы", "ВариантыОтчетов");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемы", "ОценкаПроизводительности");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемы", "Пользователи"); 
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемы", "УправлениеДоступом");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемы", "ЦентрМониторинга");
	ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, "Сведений", "СтандартныеПодсистемыДокументооборота", "СписокПоследних");
	
	Возврат Исключения;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВИсключения(Исключения, ИмяТипа)
	
	ТипМетаданных = Прав(ИмяТипа, СтрДлина(ИмяТипа) - СтрНайти(ИмяТипа, "."));
	
	Если СтрНачинаетсяСПодстроки(ИмяТипа, "РегистрСведений") Тогда
		Если Метаданные.РегистрыСведений.Найти(ТипМетаданных) <> Неопределено Тогда
			Исключения.Добавить(Тип(ИмяТипа));
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяСПодстроки(ИмяТипа, "РегистрНакопления") Тогда
		Если Метаданные.РегистрыНакоплений.Найти(ТипМетаданных) <> Неопределено Тогда
			Исключения.Добавить(Тип(ИмяТипа));
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяСПодстроки(ИмяТипа, "РегистрРасчетов") Тогда
		Если Метаданные.РегистрыРасчетов.Найти(ТипМетаданных) <> Неопределено Тогда
			Исключения.Добавить(Тип(ИмяТипа));
		КонецЕсли;
	ИначеЕсли СтрНачинаетсяСПодстроки(ИмяТипа, "Справочник") Тогда
		Если Метаданные.Справочники.Найти(ТипМетаданных) <> Неопределено Тогда
			Исключения.Добавить(Тип(ИмяТипа));
		КонецЕсли;
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРегистрыПодсистемыПервогоУровня(Исключения, ТипРегистра, ПервыйУровень)
	
	ПодсистемаПервыйУровень = Метаданные.Подсистемы.Найти(ПервыйУровень);
	
	Если ПодсистемаПервыйУровень = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущиеМетаданные Из ПодсистемаПервыйУровень.Состав Цикл
		Если Метаданные["Регистры" + ТипРегистра].Содержит(ТекущиеМетаданные) Тогда
			ДобавитьВИсключения(Исключения, "Регистр" + ТипРегистра +"НаборЗаписей." + ТекущиеМетаданные.Имя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьРегистрыПодсистемыВторогоУровня(Исключения, ТипРегистра, ПервыйУровень, ВторойУровень)
	
	ПодсистемаПервыйУровень = Метаданные.Подсистемы.Найти(ПервыйУровень);
	
	Если ПодсистемаПервыйУровень = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПодсистемаВторойУровень = ПодсистемаПервыйУровень.Подсистемы.Найти(ВторойУровень);
	
	Если ПодсистемаВторойУровень = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущиеМетаданные Из ПодсистемаВторойУровень.Состав Цикл
		Если Метаданные["Регистры" + ТипРегистра].Содержит(ТекущиеМетаданные) Тогда
			ДобавитьВИсключения(Исключения, "Регистр" + ТипРегистра +"НаборЗаписей." + ТекущиеМетаданные.Имя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СтрНачинаетсяСПодстроки(Строка, Подстрока)
	
	Возврат Лев(Строка, СтрДлина(Подстрока)) = Подстрока;
	
КонецФункции

#КонецОбласти


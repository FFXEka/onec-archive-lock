#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает персональные исключения из запрета изменения данных.
// Список проверяется при запуске управляемого приложения.
//
// Возвращаемое значение:
//   Массив Из УникальныйИдентификатор - идентификаторы ссылок на элементы справочника Пользователи.
//
// Пример:
//   Идентификаторы.Добавить(Новый УникальныйИдентификатор("12345678-1234-1234-1234-123456789abc"));
//
Функция ИдентификаторыПривилегированныхПользователей() Экспорт
	
	Идентификаторы = Новый Массив;
	
	Возврат Идентификаторы;
	
КонецФункции

// Возвращает типы справочников и планов, разрешенных к изменению.
// Для настройки передайте полное имя типа объекта в ДобавитьВИсключения.
//
// Возвращаемое значение:
//   Массив Из Тип
//
Функция ИсключенияДляСправочнойИнформации() Экспорт
	
	Исключения = Новый Массив;
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ВариантыОтчетов");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ВерсииРасширений");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ИдентификаторыОбъектовРасширений");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.ПредопределенныеВариантыОтчетов");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.РабочиеМеста");
	ДобавитьВИсключения(Исключения, "СправочникОбъект.УведомленияПрограммы");
	
	Возврат Исключения;
	
КонецФункции

// Возвращает разрешенные типы наборов записей.
// Исключения подсистем зависят от их текущего состава в основной конфигурации.
// Для настройки передайте полное имя типа набора записей в ДобавитьВИсключения.
//
// Возвращаемое значение:
//   Массив Из Тип
//
Функция ИсключенияДляРегистров() Экспорт
	
	Исключения = Новый Массив;
	ДобавитьВИсключения(Исключения, "РегистрСведенийНаборЗаписей.СведенияОПользователях");
	
	ДобавитьРегистрыПодсистемы(Исключения, "УправлениеБизнесПроцессами");
	ДобавитьРегистрыПодсистемы(Исключения, "ИнтернетПоддержкаПользователей", "Новости");
	ДобавитьРегистрыПодсистемы(Исключения, "ИнтернетПоддержкаПользователей", "РасписанияРегламентныхЗаданий");
	ДобавитьРегистрыПодсистемы(Исключения, "НастройкаИАдминистрирование", "Метрики");
	ДобавитьРегистрыПодсистемы(Исключения, "СлужебныеПодсистемы", "МобильныйКлиент");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемы", "БазоваяФункциональность");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемы", "ВариантыОтчетов");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемы", "ОценкаПроизводительности");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемы", "Пользователи");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемы", "УправлениеДоступом");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемы", "ЦентрМониторинга");
	ДобавитьРегистрыПодсистемы(Исключения, "СтандартныеПодсистемыДокументооборота", "СписокПоследних");
	
	Возврат Исключения;
	
КонецФункции

// Возвращает данные для проверки персонального исключения.
// При пустом списке исключений не обращается к БСП.
//
// Возвращаемое значение:
//   Структура:
//     * Идентификатор - УникальныйИдентификатор, Неопределено - идентификатор ссылки на элемент
//       справочника Пользователи. Неопределено, если список исключений пуст или пользователь не определен.
//     * РазрешенныеИдентификаторы - Массив Из УникальныйИдентификатор - персональные исключения.
//
Функция КонтекстТекущегоПользователя() Экспорт
	
	Идентификаторы = ИдентификаторыПривилегированныхПользователей();
	Идентификатор = Неопределено;
	Если Идентификаторы.Количество() > 0 Тогда
		Идентификатор = ИдентификаторТекущегоПользователяБСП();
	КонецЕсли;
	
	Возврат Новый Структура("Идентификатор, РазрешенныеИдентификаторы", Идентификатор, Идентификаторы);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИдентификаторТекущегоПользователяБСП()
	
	Если Метаданные.Справочники.Найти("Пользователи") = Неопределено
		Или Метаданные.ОбщиеМодули.Найти("Пользователи") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		// Фиксированный вызов сохраняет применимость расширения без БСП.
		Пользователь = Вычислить("Пользователи.ТекущийПользователь()");
		Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи")
			И ЗначениеЗаполнено(Пользователь) Тогда
			Возврат Пользователь.УникальныйИдентификатор();
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("БлокировкаАрхива.ИсключениеПользователя", УровеньЖурналаРегистрации.Ошибка,
			, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьВИсключения(Исключения, ИмяТипа)
	
	ЧастиИмени = СтрРазделить(ИмяТипа, ".");
	Если ЧастиИмени.Количество() <> 2 Или ПустаяСтрока(ЧастиИмени[1]) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru='Неверное имя типа исключения: %1'"), ИмяТипа);
	КонецЕсли;
	
	Класс = КлассыМетаданныхИсключений().Получить(ЧастиИмени[0]);
	Если Класс = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru='Не поддерживается тип исключения: %1'"), ИмяТипа);
	КонецЕсли;
	
	Если Метаданные.НайтиПоПолномуИмени(Класс + "." + ЧастиИмени[1]) <> Неопределено Тогда
		ДобавитьТипБезПовторения(Исключения, Тип(ИмяТипа));
	КонецЕсли;
	
КонецПроцедуры

Функция КлассыМетаданныхИсключений()
	
	Классы = Новый Соответствие;
	Классы.Вставить("СправочникОбъект", "Справочник");
	Классы.Вставить("ПланОбменаОбъект", "ПланОбмена");
	Классы.Вставить("ПланСчетовОбъект", "ПланСчетов");
	Классы.Вставить("ПланВидовРасчетаОбъект", "ПланВидовРасчета");
	Классы.Вставить("ПланВидовХарактеристикОбъект", "ПланВидовХарактеристик");
	Классы.Вставить("РегистрСведенийНаборЗаписей", "РегистрСведений");
	Классы.Вставить("РегистрНакопленияНаборЗаписей", "РегистрНакопления");
	Классы.Вставить("РегистрБухгалтерииНаборЗаписей", "РегистрБухгалтерии");
	Классы.Вставить("РегистрРасчетаНаборЗаписей", "РегистрРасчета");
	
	Возврат Классы;
	
КонецФункции

Процедура ДобавитьРегистрыПодсистемы(Исключения, ИмяПодсистемы, ИмяВложеннойПодсистемы = "")
	
	Подсистема = Метаданные.Подсистемы.Найти(ИмяПодсистемы);
	Если Подсистема = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяВложеннойПодсистемы) Тогда
		Подсистема = Подсистема.Подсистемы.Найти(ИмяВложеннойПодсистемы);
		Если Подсистема = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
			ДобавитьТипБезПовторения(Исключения, Тип("РегистрСведенийНаборЗаписей." + ОбъектМетаданных.Имя));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТипБезПовторения(Исключения, ТипОбъекта)
	
	Если Исключения.Найти(ТипОбъекта) = Неопределено Тогда
		Исключения.Добавить(ТипОбъекта);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

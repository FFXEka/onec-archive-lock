#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗапретитьЗаписьРегистров(Источник, Отказ, Замещение, ТолькоЗапись = Неопределено, ЗаписьФактическогоПериодаДействия = Неопределено, ЗаписьПерерасчетов = Неопределено) Экспорт
	
	Если ТекущемуПользователюЗаписьРазрешена() Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипРегистраПопадаетВИсключение(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ПрерватьЗаписьОбъекта();
	
КонецПроцедуры

Процедура ЗапретитьЗаписьРегистрацииХозяйтвеннойДеятельности(Источник, Отказ, РежимЗаписи = Неопределено, РежимПроведения = Неопределено) Экспорт
	
	Если ТекущемуПользователюЗаписьРазрешена() Тогда
		Возврат;
	КонецЕсли;
	
	ПрерватьЗаписьОбъекта();
	
КонецПроцедуры

Процедура ЗапретитьЗаписьСправочнойИнформации(Источник, Отказ) Экспорт
	
	Если ТекущемуПользователюЗаписьРазрешена() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипОбъектаСправочнойИнформацииПопадаетВИсключение(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ПрерватьЗаписьОбъекта();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрерватьЗаписьОбъекта()
	
	ТекстИсключения = НСтр("ru='Изменения запрещены. Это архивная база'");
	ВызватьИсключение(ТекстИсключения);
	
КонецПроцедуры

Функция ТекущемуПользователюЗаписьРазрешена()
	
	Перем ПользователиАдапт;
	
	Если Метаданные.Справочники.Найти("Пользователи") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выполнить("ПользователиАдапт = Пользователи");
	
	ИдентификаторыПривилегированныхПользователей = ПолнаяБлокировкаСерверПереопределяемый.ИдентификаторыПривилегированныхПользователей();
	ПривелигерованныеПользователи = Новый Массив;
	
	Для Каждого ТекущийУИД Из ИдентификаторыПривилегированныхПользователей Цикл
		Пользователь = Справочники.Пользователи.ПолучитьСсылку(ТекущийУИД);
		Если ЗначениеЗаполнено(Пользователь) Тогда
			ПривелигерованныеПользователи.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;
	
	Возврат (ПривелигерованныеПользователи.Найти(ПользователиАдапт.ТекущийПользователь()) <> Неопределено);
	
КонецФункции

Функция ТипОбъектаСправочнойИнформацииПопадаетВИсключение(Источник)
	
	Исключения = ПолнаяБлокировкаСерверПереопределяемый.ИсключенияДляСправочнойИнформации();
	
	Возврат (Исключения.Найти(ТипЗнч(Источник)) <> Неопределено);
	
КонецФункции

Функция ТипРегистраПопадаетВИсключение(Источник)
	
	Исключения = ПолнаяБлокировкаСерверПереопределяемый.ИсключенияДляРегистров();
	
	Возврат (Исключения.Найти(ТипЗнч(Источник)) <> Неопределено);
	
КонецФункции

#КонецОбласти

#Иначе
НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

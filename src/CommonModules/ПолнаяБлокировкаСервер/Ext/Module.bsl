#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Проверяет запись набора регистра или перерасчета, в том числе при загрузке обмена.
// Пустой набор разрешено записать в режиме добавления.
//
// Параметры:
//   Источник - РегистрСведенийНаборЗаписей, РегистрНакопленияНаборЗаписей, РегистрБухгалтерииНаборЗаписей,
//     РегистрРасчетаНаборЗаписей, ПерерасчетНаборЗаписей - записываемый набор.
//   Отказ - Булево - устанавливается в Истина при запрете записи.
//   Замещение - Булево, РежимЗамещения, Неопределено - режим записи набора, переданный платформой.
//   ТолькоЗапись - Булево, Неопределено - параметр события для регистра расчета.
//   ЗаписьФактическогоПериодаДействия - Булево, Неопределено - параметр события для регистра расчета.
//   ЗаписьПерерасчетов - Булево, Неопределено - параметр события для регистра расчета.
//
Процедура ЗапретитьЗаписьРегистров(Источник, Отказ, Замещение = Неопределено, ТолькоЗапись = Неопределено, ЗаписьФактическогоПериодаДействия = Неопределено, ЗаписьПерерасчетов = Неопределено) Экспорт
	
	// Пустой набор с замещением может удалить сохраненные записи.
	Если Источник.Количество() = 0 И РежимДобавленияЗаписей(Замещение) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекущемуПользователюИзменениеРазрешено()
		И ПолнаяБлокировкаСерверПереопределяемый.ИсключенияДляРегистров().Найти(ТипЗнч(Источник)) = Неопределено Тогда
		ПрерватьИзменение(Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Запрещает запись документа, бизнес-процесса или задачи пользователю без персонального исключения.
//
// Параметры:
//   Источник - ДокументОбъект, БизнесПроцессОбъект, ЗадачаОбъект - записываемый объект.
//   Отказ - Булево - устанавливается в Истина при запрете записи.
//   РежимЗаписи - РежимЗаписиДокумента, Неопределено - режим записи, передаваемый для документа.
//   РежимПроведения - РежимПроведенияДокумента, Неопределено - режим проведения, передаваемый для документа.
//
Процедура ЗапретитьЗаписьРегистрацииХозяйтвеннойДеятельности(Источник, Отказ, РежимЗаписи = Неопределено, РежимПроведения = Неопределено) Экспорт
	
	ПроверитьИзменениеУчетногоОбъекта(Отказ);
	
КонецПроцедуры

// Запрещает удаление документа, бизнес-процесса или задачи пользователю без персонального исключения.
//
// Параметры:
//   Источник - ДокументОбъект, БизнесПроцессОбъект, ЗадачаОбъект - удаляемый объект.
//   Отказ - Булево - устанавливается в Истина при запрете удаления.
//
Процедура ЗапретитьУдалениеУчетныхОбъектов(Источник, Отказ) Экспорт
	
	ПроверитьИзменениеУчетногоОбъекта(Отказ);
	
КонецПроцедуры

// Проверяет персональные исключения и исключения по типу перед записью справочника или плана.
//
// Параметры:
//   Источник - СправочникОбъект, ПланОбменаОбъект, ПланСчетовОбъект, ПланВидовРасчетаОбъект,
//     ПланВидовХарактеристикОбъект - записываемый объект.
//   Отказ - Булево - устанавливается в Истина при запрете записи.
//
Процедура ЗапретитьЗаписьСправочнойИнформации(Источник, Отказ) Экспорт
	
	ПроверитьИзменениеСправочнойИнформации(Источник, Отказ);
	
КонецПроцедуры

// Проверяет персональные исключения и исключения по типу перед удалением справочника или плана.
//
// Параметры:
//   Источник - СправочникОбъект, ПланОбменаОбъект, ПланСчетовОбъект, ПланВидовРасчетаОбъект,
//     ПланВидовХарактеристикОбъект - удаляемый объект.
//   Отказ - Булево - устанавливается в Истина при запрете удаления.
//
Процедура ЗапретитьУдалениеСправочнойИнформации(Источник, Отказ) Экспорт
	
	ПроверитьИзменениеСправочнойИнформации(Источник, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет при запуске управляемого приложения настройки персональных исключений.
// Вызывает исключение, если список заполнен неверно или ссылки пользователей недоступны для проверки.
//
// Параметры:
//   Идентификаторы - Массив Из УникальныйИдентификатор - идентификаторы ссылок справочника Пользователи.
//
Процедура ПроверитьПерсональныеИсключения(Идентификаторы) Экспорт
	
	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru='Настройка персональных исключений должна возвращать массив уникальных идентификаторов.'");
	КонецЕсли;
	
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Индекс = 0 По Идентификаторы.ВГраница() Цикл
		Если ТипЗнч(Идентификаторы[Индекс]) <> Тип("УникальныйИдентификатор") Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru='Персональное исключение № %1 должно быть уникальным идентификатором. Получен тип: %2.'"),
				Индекс + 1, ТипЗнч(Идентификаторы[Индекс]));
		КонецЕсли;
	КонецЦикла;
	
	МетаданныеПользователей = Метаданные.Справочники.Найти("Пользователи");
	Если МетаданныеПользователей = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Для персональных исключений в конфигурации нужен справочник Пользователи.'");
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", МетаданныеПользователей) Тогда
		ВызватьИсключение НСтр("ru='Для проверки персональных исключений требуется право чтения справочника Пользователи.'");
	КонецЕсли;
	
	МенеджерПользователей = Справочники[МетаданныеПользователей.Имя];
	Ссылки = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Ссылки.Добавить(МенеджерПользователей.ПолучитьСсылку(Идентификатор));
	КонецЦикла;
	
	// Проверка проходит, только если в текущем сеансе доступна каждая ссылка из списка.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Ссылка В (&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	ДоступныеСсылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Для Индекс = 0 По Ссылки.ВГраница() Цикл
		Если ДоступныеСсылки.Найти(Ссылки[Индекс]) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru='Исключение № %1 (%2). Пользователь отсутствует в справочнике или недоступен для чтения.'"),
				Индекс + 1, Идентификаторы[Индекс]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РежимДобавленияЗаписей(Замещение)
	
	Если Замещение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Замещение) = Тип("Булево") Тогда
		Возврат Не Замещение;
	КонецЕсли;
	
	// Перечисление доступно начиная с 8.3.25. На старых платформах передается Булево.
	Возврат (Замещение = Вычислить("РежимЗамещения.Добавление"));
	
КонецФункции

Процедура ПроверитьИзменениеУчетногоОбъекта(Отказ)
	
	Если Не ТекущемуПользователюИзменениеРазрешено() Тогда
		ПрерватьИзменение(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьИзменениеСправочнойИнформации(Источник, Отказ)
	
	Если Не ТекущемуПользователюИзменениеРазрешено()
		И ПолнаяБлокировкаСерверПереопределяемый.ИсключенияДляСправочнойИнформации().Найти(
			ТипЗнч(Источник)) = Неопределено Тогда
		ПрерватьИзменение(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекущемуПользователюИзменениеРазрешено()
	
	КонтекстПользователя = ПолнаяБлокировкаСерверПереопределяемый.КонтекстТекущегоПользователя();
	Идентификатор = КонтекстПользователя.Идентификатор;
	
	Возврат (Идентификатор <> Неопределено
		И КонтекстПользователя.РазрешенныеИдентификаторы.Найти(Идентификатор) <> Неопределено);
	
КонецФункции

Процедура ПрерватьИзменение(Отказ)
	
	Отказ = Истина;
	ВызватьИсключение НСтр("ru='Изменения запрещены. Это архивная база'");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
